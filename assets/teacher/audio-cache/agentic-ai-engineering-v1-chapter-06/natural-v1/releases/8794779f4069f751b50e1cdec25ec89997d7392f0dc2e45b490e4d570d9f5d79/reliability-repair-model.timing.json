Ms":37140},{"text":"the checker approves.","startMs":37140,"endMs":39040},{"text":"A checker can miss a defect.","startMs":39040,"endMs":41240},{"text":"A repair can satisfy one test while breaking another","startMs":41240,"endMs":43740},{"text":"property.","startMs":43740,"endMs":45160},{"text":"Those cases require additional states or direct measurement.","startMs":45160,"endMs":48900},{"text":"The useful idea is that a detected error creates","startMs":48900,"endMs":51620},{"text":"an opportunity for repair, not a guarantee that the","startMs":51620,"endMs":54960},{"text":"foundation is now clean.","startMs":54960,"endMs":56100}],"boardEvents":[{"atMs":0,"actionIndex":0},{"atMs":19540,"actionIndex":1},{"atMs":21240,"actionIndex":2},{"atMs":23000,"actionIndex":3},{"atMs":23000,"actionIndex":4},{"atMs":24160,"actionIndex":5},{"atMs":24160,"actionIndex":6},{"atMs":36500,"actionIndex":7}],"boardTimingMethod":"authored-spoken-cues-v1"}