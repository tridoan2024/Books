endChar":831,"startMs":49020,"endMs":49580,"confidence":0.9203,"matched":true}],"phrases":[{"text":"Suppose a checkpoint covers four steps.","startMs":0,"endMs":2920},{"text":"Its initial success means the entire segment is correct,","startMs":2920,"endMs":6260},{"text":"so call that probability q.","startMs":6260,"endMs":8280},{"text":"Its detection rate concerns an incorrect segment, and its","startMs":8280,"endMs":11560},{"text":"repair rate concerns making the whole segment correct.","startMs":11560,"endMs":14860},{"text":"These are different measurements from single-step rates.","startMs":14860,"endMs":18160},{"text":"Under an additional independent-step assumption, q could equal 0.94","startMs":18160,"endMs":21820},{"text":"0.94 to the fourth power.","startMs":21820,"endMs":23720},{"text":"You would then apply the correction expression to q","startMs":23720,"endMs":26180},{"text":"using segment-specific detection and repair estimates.","startMs":26180,"endMs":29000},{"text":"You cannot take a per-step improvement and claim the","startMs":29000,"endMs":32460},{"text":"same benefit from checking only once every four steps.","startMs":32460,"endMs":35360},{"text":"False alarms, repair regressions, and shared dependencies complicate either","startMs":35360,"endMs":40420},{"text":"model.","startMs":40420,"endMs":41640},{"text":"Keep the event and denominator beside every number.","startMs":41640,"endMs":45000},{"text":"Similar numerical results from two toy calculations do not","startMs":45000,"endMs":48260},{"text":"make their assumptions interchangeable.","startMs":48260,"endMs":49580}],"boardEvents":[{"atMs":0,"actionIndex":0},{"atMs":4100,"actionIndex":1},{"atMs":9640,"actionIndex":2},{"atMs":12440,"actionIndex":3},{"atMs":15260,"actionIndex":4},{"atMs":41640,"actionIndex":5}],"boardTimingMethod":"authored-spoken-cues-v1"}