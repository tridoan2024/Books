startChar":1269,"endChar":1280,"startMs":82020,"endMs":82560,"confidence":0.9992,"matched":true}],"phrases":[{"text":"A dependency upgrade is our first case.","startMs":0,"endMs":3300},{"text":"In Priya's fictional service fleet, the loop treats every","startMs":3300,"endMs":6600},{"text":"red integration run as a reason to change application","startMs":6600,"endMs":9560},{"text":"code.","startMs":9560,"endMs":10720},{"text":"Some failures actually come from network timing and database","startMs":10720,"endMs":13840},{"text":"readiness.","startMs":13840,"endMs":15280},{"text":"Repeated attempts eventually turn green by chance, creating a","startMs":15280,"endMs":19160},{"text":"costly and misleading feedback signal.","startMs":19160,"endMs":21280},{"text":"A sorting function is our second case.","startMs":21280,"endMs":24860},{"text":"A test checks that the output is ordered, yet","startMs":24860,"endMs":27660},{"text":"an implementation returning an empty list passes that property","startMs":27660,"endMs":31220},{"text":"while losing every input element.","startMs":31220,"endMs":34180},{"text":"A polished report is our third case.","startMs":34180,"endMs":36920},{"text":"Its evaluator rewards organization and confidence but misses unsupported","startMs":36920,"endMs":41140},{"text":"claims.","startMs":41140,"endMs":42400},{"text":"Each case shows a different way that a precise","startMs":42400,"endMs":44900},{"text":"verdict can fail to represent the intended quality.","startMs":44900,"endMs":48620},{"text":"These examples are illustrative, and their costs and rates","startMs":48620,"endMs":52140},{"text":"are not operating estimates for your system.","startMs":52140,"endMs":54540},{"text":"Our governing question is: what does this verdict actually","startMs":54540,"endMs":58580},{"text":"establish?","startMs":58580,"endMs":60160},{"text":"We will choose appropriate checks, distinguish instruments from evaluators,","startMs":60160,"endMs":65040},{"text":"calculate error rates with explicit denominators, and layer requirements","startMs":65040,"endMs":69080},{"text":"without hiding uncertainty.","startMs":69080,"endMs":71440},{"text":"By the end, you should be able to design","startMs":71440,"endMs":73480},{"text":"a verification path that produces actionable evidence, preserves missing","startMs":73480,"endMs":77940},{"text":"checks, and spends more only when the additional assessment","startMs":77940,"endMs":81200},{"text":"serves a real requirement.","startMs":81200,"endMs":82560}],"boardEvents":[{"atMs":0,"actionIndex":0},{"atMs":0,"actionIndex":1},{"atMs":21280,"actionIndex":2},{"atMs":34180,"actionIndex":3},{"atMs":44480,"actionIndex":4},{"atMs":54540,"actionIndex":5}],"boardTimingMethod":"authored-spoken-cues-v1"}