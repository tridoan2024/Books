ndMs":19700},{"text":"A grouped package request is our second case.","startMs":19700,"endMs":22460},{"text":"The response looks like valid structured data yet silently","startMs":22460,"endMs":25700},{"text":"omits one package.","startMs":25700,"endMs":26860},{"text":"Fewer tokens did not deliver the same service.","startMs":26860,"endMs":30460},{"text":"A discounted asynchronous job is our third case.","startMs":30460,"endMs":33640},{"text":"Its permitted completion window extends beyond the deadline for","startMs":33640,"endMs":36720},{"text":"delivering the security report.","startMs":36720,"endMs":38860},{"text":"The headline discount therefore cannot establish suitability.","startMs":38860,"endMs":42560},{"text":"These cases are illustrative engineering scenarios, not measured savings","startMs":42560,"endMs":46360},{"text":"or current provider offers.","startMs":46360,"endMs":48460},{"text":"Their common mechanism is that cost changes can alter","startMs":48460,"endMs":51240},{"text":"coverage, failure coupling, and delivery time.","startMs":51240,"endMs":54020},{"text":"Our governing question is: how do we reduce expense","startMs":54020,"endMs":57540},{"text":"while preserving the required result?","startMs":57540,"endMs":59920},{"text":"We will quantify prefix reuse, distinguish two kinds of","startMs":59920,"endMs":63060},{"text":"batching, design evidence-aware routing, evaluate compression, and stop","startMs":63060,"endMs":67540},{"text":"unproductive work.","startMs":67540,"endMs":69060},{"text":"By the end, you should be able to propose","startMs":69060,"endMs":71100},{"text":"a cost change with an explicit quality constraint and","startMs":71100,"endMs":74020},{"text":"a credible recovery path.","startMs":74020,"endMs":75320}],"boardEvents":[{"atMs":0,"actionIndex":0},{"atMs":0,"actionIndex":1},{"atMs":19700,"actionIndex":2},{"atMs":30460,"actionIndex":3},{"atMs":50080,"actionIndex":4},{"atMs":54020,"actionIndex":5}],"boardTimingMethod":"authored-spo