k","key":"work","startChar":1272,"endChar":1276,"startMs":79120,"endMs":79300,"confidence":0.9986,"matched":true},{"text":"together","key":"together","startChar":1277,"endChar":1285,"startMs":79300,"endMs":79700,"confidence":0.9982,"matched":true},{"text":"within","key":"within","startChar":1286,"endChar":1292,"startMs":79700,"endMs":79980,"confidence":0.9797,"matched":true},{"text":"the","key":"the","startChar":1293,"endChar":1296,"startMs":79980,"endMs":80200,"confidence":0.9973,"matched":true},{"text":"same","key":"same","startChar":1297,"endChar":1301,"startMs":80200,"endMs":80360,"confidence":0.9999,"matched":true},{"text":"step","key":"step","startChar":1302,"endChar":1306,"startMs":80360,"endMs":80700,"confidence":0.9958,"matched":true}],"phrases":[{"text":"A staging deployment monitor is our first case.","startMs":0,"endMs":3320},{"text":"In Rani's fictional workflow, a webhook identifies a deployment,","startMs":3320,"endMs":7740},{"text":"metrics show what changed, and the system produces an","startMs":7740,"endMs":10600},{"text":"assessment for possible production promotion.","startMs":10600,"endMs":13760},{"text":"Each operation needs a different kind of work.","startMs":13760,"endMs":16700},{"text":"A date parser is our second case.","startMs":16700,"endMs":19220},{"text":"Unfamiliar formats do not automatically justify asking a model","startMs":19220,"endMs":22600},{"text":"to guess; a supported parser or explicit rejection may","startMs":22600,"endMs":26540},{"text":"be more reliable.","startMs":26540,"endMs":27320},{"text":"A summary message is our third case.","startMs":27320,"endMs":31140},{"text":"A template may communicate structured results clearly, while a","startMs":31140,"endMs":34200},{"text":"model may help when the explanation requires bounded synthesis.","startMs":34200,"endMs":38440},{"text":"These cases show why choosing a primitive starts with","startMs":38440,"endMs":41080},{"text":"required behavior, not a favorite technology.","startMs":41080,"endMs":44620},{"text":"The chapter's cost and latency figures are illustrative and","startMs":44620,"endMs":47860},{"text":"must be measured for the actual system.","startMs":47860,"endMs":50400},{"text":"Our governing question is: which combination meets the contract","startMs":50400,"endMs":53760},{"text":"with the least unnecessary complexity?","startMs":53760,"endMs":55580},{"text":"We will define hard constraints, map behavior to mechanisms,","startMs":55580,"endMs":60720},{"text":"compare complete designs, and choose fallbacks that preserve mandatory","startMs":60720,"endMs":64500},{"text":"checks.","startMs":64500,"endMs":65620},{"text":"By the end, you should be able to justify","startMs":65620,"endMs":67800},{"text":"one operation's implementation and interface separately, identify the evidence","startMs":67800,"endMs":72380},{"text":"that would change the choice, and prevent a cheap","startMs":72380,"endMs":75220},{"text":"fallback from silently weakening acceptance.","startMs":75220,"endMs":77460},{"text":"The primitives can work together within the same step.","startMs":77460,"endMs":80700}],"boardEvents":[{"atMs":0,"actionIndex":0},{"atMs":0,"actionIndex":1},{"atMs":16700,"actionIndex":2},{"atMs":27320,"actionIndex":3},{"atMs":50400,"actionIndex":4},{"atMs":77460,"actionIndex":5}],"boardTimingMethod":"authored-spoken-cues-v1"}