endChar":1284,"startMs":78080,"endMs":78440,"confidence":0.9611,"matched":true},{"text":"use","key":"use","startChar":1285,"endChar":1288,"startMs":78440,"endMs":78700,"confidence":0.9966,"matched":true},{"text":"the","key":"the","startChar":1289,"endChar":1292,"startMs":78700,"endMs":78880,"confidence":0.9983,"matched":true},{"text":"same","key":"same","startChar":1293,"endChar":1297,"startMs":78880,"endMs":79060,"confidence":0.9995,"matched":true},{"text":"connector","key":"connector","startChar":1298,"endChar":1307,"startMs":79060,"endMs":79480,"confidence":0.9965,"matched":true}],"phrases":[{"text":"A passing patch is our first case.","startMs":0,"endMs":2700},{"text":"In Marcus's fictional developer-experience workflow, the agent produces code","startMs":2700,"endMs":6960},{"text":"quickly, but people still move it through a branch,","startMs":6960,"endMs":9780},{"text":"pull request, continuous integration, and review.","startMs":9780,"endMs":13120},{"text":"Connectors can automate authorized parts of that delivery work.","startMs":13120,"endMs":16720},{"text":"A production rollback is our second case.","startMs":16720,"endMs":19420},{"text":"The connector can reach the deployment service, but the","startMs":19420,"endMs":22220},{"text":"current user approval may concern a different service or","startMs":22220,"endMs":25040},{"text":"an older revision.","startMs":25040,"endMs":26580},{"text":"A single internal lookup is our third case.","startMs":26580,"endMs":29300},{"text":"Wrapping one stable endpoint in a separate protocol server","startMs":29300,"endMs":33040},{"text":"may add maintenance and latency without useful reuse.","startMs":33040,"endMs":37140},{"text":"These cases show why integration design needs both a","startMs":37140,"endMs":39920},{"text":"benefit and a boundary.","startMs":39920,"endMs":42120},{"text":"The chapter's delivery times and pass rates are fictional","startMs":42120,"endMs":44640},{"text":"illustration, not measured evidence of an MCP performance gain.","startMs":44640,"endMs":49240},{"text":"Our governing question is: when does a connector earn","startMs":49240,"endMs":52140},{"text":"its cost and trust?","startMs":52140,"endMs":54000},{"text":"We will distinguish protocol capabilities, implementation responsibilities, current task","startMs":54000,"endMs":59060},{"text":"approval, and failure recovery.","startMs":59060,"endMs":61400},{"text":"By the end, you should be able to justify","startMs":61400,"endMs":63480},{"text":"a direct adapter or an MCP server, trace its","startMs":63480,"endMs":66920},{"text":"actual authority, and test a consequential call without performing","startMs":66920,"endMs":70440},{"text":"a live production mutation.","startMs":70440,"endMs":72620},{"text":"Connectivity and autonomy are different dimensions: either a fixed","startMs":72620,"endMs":76320},{"text":"workflow or an adaptive loop can use the same","startMs":76320,"endMs":79060},{"text":"connector.","startMs":79060,"endMs":79480}],"boardEvents":[{"atMs":0,"actionIndex":0},{"atMs":0,"actionIndex":1},{"atMs":16720,"actionIndex":2},{"atMs":26580,"actionIndex":3},{"atMs":49240,"actionIndex":4},{"atMs":72620,"actionIndex":5}],"boardTimingMethod":"authored-spoken-cues-v1"}