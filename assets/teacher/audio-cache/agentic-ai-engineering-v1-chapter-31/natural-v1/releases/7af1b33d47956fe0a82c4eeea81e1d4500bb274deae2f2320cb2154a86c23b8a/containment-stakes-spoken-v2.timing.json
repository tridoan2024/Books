320,"confidence":0.9975,"matched":true},{"text":"actually","key":"actually","startChar":1248,"endChar":1256,"startMs":86320,"endMs":86640,"confidence":0.9942,"matched":true},{"text":"ran","key":"ran","startChar":1257,"endChar":1260,"startMs":86640,"endMs":86920,"confidence":0.992,"matched":true}],"phrases":[{"text":"A deployment bot with cluster-wide administrator access is","startMs":0,"endMs":4200},{"text":"our first case.","startMs":4200,"endMs":6080},{"text":"In the chapter's fictional scenario, the bot needs only","startMs":6080,"endMs":9180},{"text":"a narrow deployment workflow, but broad permission was granted","startMs":9180,"endMs":13000},{"text":"to get past setup errors.","startMs":13000,"endMs":15460},{"text":"Normal success never exercises most of that authority, so","startMs":15460,"endMs":19460},{"text":"even several quiet months cannot establish that unnecessary permissions","startMs":19460,"endMs":23420},{"text":"are harmless or that the right boundary was tested.","startMs":23420,"endMs":26800},{"text":"A coding worker running tests is our second case.","startMs":26800,"endMs":31420},{"text":"The test command executes repository code, which may itself","startMs":31420,"endMs":35080},{"text":"be hostile and able to inspect inherited secrets or","startMs":35080,"endMs":38460},{"text":"reach the network.","startMs":38460,"endMs":40280},{"text":"A credential proxy is our third case.","startMs":40280,"endMs":43100},{"text":"The model never sees the token, yet a generic","startMs":43100,"endMs":46020},{"text":"authenticated proxy might let it perform operations far beyond","startMs":46020,"endMs":50080},{"text":"the task.","startMs":50080,"endMs":50660},{"text":"These are illustrative designs, not measured production incidents or","startMs":50660,"endMs":55800},{"text":"guarantees about a particular platform.","startMs":55800,"endMs":58940},{"text":"Their common lesson is that containment depends on effective","startMs":58940,"endMs":61980},{"text":"capability, including indirect paths.","startMs":61980,"endMs":65820},{"text":"Our governing question is: what can the worker do","startMs":65820,"endMs":69040},{"text":"if every proposal is malicious?","startMs":69040,"endMs":72100},{"text":"We will inspect network policy, brokers, filesystems, subprocesses, deployment","startMs":72100,"endMs":77740},{"text":"admission, and shutdown.","startMs":77740,"endMs":79100},{"text":"By the end, you should be able to test","startMs":79100,"endMs":81980},{"text":"a boundary and explain the remaining blast radius with","startMs":81980,"endMs":85260},{"text":"evidence about what actually ran.","startMs":85260,"endMs":86920}],"boardEvents":[{"atMs":0,"actionIndex":0},{"atMs":0,"actionIndex":1},{"atMs":15460,"actionIndex":2},{"atMs":26800,"actionIndex":3},{"atMs":40280,"actionIndex":4},{"atMs":65820,"actionIndex":5}],"boardTimingMethod":"authored-spoken-cues-v1"}