87,"endChar":1295,"startMs":80780,"endMs":81180,"confidence":0.9909,"matched":true},{"text":"a","key":"a","startChar":1297,"endChar":1298,"startMs":81860,"endMs":81860,"confidence":0.9848,"matched":true},{"text":"bounded","key":"bounded","startChar":1299,"endChar":1306,"startMs":81860,"endMs":82120,"confidence":0.9803,"matched":true},{"text":"hybrid","key":"hybrid","startChar":1307,"endChar":1313,"startMs":82120,"endMs":82580,"confidence":0.994,"matched":true},{"text":"or","key":"or","startChar":1315,"endChar":1317,"startMs":83100,"endMs":83380,"confidence":0.9941,"matched":true},{"text":"no","key":"no","startChar":1318,"endChar":1320,"startMs":83380,"endMs":83820,"confidence":0.9727,"matched":true},{"text":"new","key":"new","startChar":1321,"endChar":1324,"startMs":83820,"endMs":84100,"confidence":0.9689,"matched":true},{"text":"automation","key":"automation","startChar":1325,"endChar":1335,"startMs":84100,"endMs":84480,"confidence":0.9907,"matched":true}],"phrases":[{"text":"A pull-request description generator is our first case.","startMs":0,"endMs":4020},{"text":"In the chapter's fictional story, Marcus builds a production","startMs":4020,"endMs":7060},{"text":"loop to summarize changes, list affected systems, and flag","startMs":7060,"endMs":11460},{"text":"breaking changes.","startMs":11460,"endMs":13420},{"text":"Most descriptions are acceptable on the first pass, while","startMs":13420,"endMs":16600},{"text":"a smaller group of difficult diffs consumes the iteration","startMs":16600,"endMs":19460},{"text":"machinery.","startMs":19460,"endMs":20940},{"text":"A template-assisted workflow with human handling of exceptions may","startMs":20940,"endMs":24820},{"text":"be a better complete alternative.","startMs":24820,"endMs":26260},{"text":"Generating infrastructure modules is our second case.","startMs":26260,"endMs":30560},{"text":"Repeated validation and repair may help, but the economics","startMs":30560,"endMs":33860},{"text":"change sharply with request volume and maintenance effort.","startMs":33860,"endMs":37680},{"text":"A subjective document draft is our third case.","startMs":37680,"endMs":41000},{"text":"Generating more versions does not demonstrate improvement when nobody","startMs":41000,"endMs":44560},{"text":"can specify the quality judgment that should guide the","startMs":44560,"endMs":47100},{"text":"next revision.","startMs":47100,"endMs":48820},{"text":"These are illustrative design cases, not measured production outcomes","startMs":48820,"endMs":52600},{"text":"or current price quotes.","startMs":52600,"endMs":54100},{"text":"Their common mechanism is that iteration has a cost","startMs":54100,"endMs":57860},{"text":"and needs a discriminating signal and a useful purpose.","startMs":57860,"endMs":62000},{"text":"Our governing question is: when does iteration earn its","startMs":62000,"endMs":65400},{"text":"extra complexity?","startMs":65400,"endMs":67140},{"text":"By the end, you should be able to apply","startMs":67140,"endMs":69080},{"text":"three decision gates, compare complete alternatives, test the important","startMs":69080,"endMs":73500},{"text":"economic assumptions, and identify what can happen before an","startMs":73500,"endMs":76980},{"text":"approval gate.","startMs":76980,"endMs":77580},{"text":"The useful answer may be a loop, a fixed","startMs":77580,"endMs":80780},{"text":"workflow, a bounded hybrid, or no new automation.","startMs":80780,"endMs":84480}],"boardEvents":[{"atMs":0,"actionIndex":0},{"atMs":0,"actionIndex":1},{"atMs":25000,"actionIndex":2},{"atMs":26260,"actionIndex":3},{"atMs":37680,"actionIndex":4},{"atMs":62000,"actionIndex":5}],"boardTimingMethod":"authored-spoken-cues-v1"}